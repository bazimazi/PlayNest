{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlayNest",
  "version": "../package.json",
  "identifier": "app.playnest.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PlayNest",
        "width": 480,
        "height": 900,
        "minWidth": 360,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "backgroundColor": "#fff9e8"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "media-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Play ideas, stories, songs and help for hard moments, for parents of children from birth to 12.",
    "longDescription": "PlayNest answers one question, what shall we play right now?, then gets out of the way. Private and offline: no account, no server, no tracking.",
    "copyright": "Copyright (c) 2026 bazimazi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
