{
  "name": "playnest",
  "private": true,
  "version": "1.5.0",
  "description": "PlayNest — research-backed play, stories, songs and help for hard moments, for parents of children from birth to 12.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "npm run build && cap sync",
    "android": "npm run build && cap sync android && cap open android",
    "ios": "npm run build && cap sync ios && cap open ios",
    "e2e": "npm run build && node e2e/smoke.mjs",
    "e2e:fa": "npm run build && node e2e/persian.mjs",
    "i18n": "vite-node scripts/i18n.ts"
  },
  "dependencies": {
    "@capacitor/core": "8.6.0",
    "minisearch": "^7.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/cli": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@iconify-json/fluent-emoji": "^1.2.7",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "4.10.2",
    "emojibase-data": "^18.0.0",
    "playwright-core": "1.48.2",
    "svgo": "^3.3.5",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
